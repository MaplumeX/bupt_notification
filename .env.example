# 复制成 .env 后填写：cp .env.example .env
# .env 已被 .gitignore / .dockerignore 排除，不会进 git，也不会进镜像。

# ===== 北邮第二课堂账号 =====
# 用于首次拿 token，以及 token 过期（约 3 天）后自动续期。
# 不填也能跑，但必须先把 BUPT_TOKEN 填上（见下），且到期后无法自动续期。
BUPT_USERNAME=
BUPT_PASSWORD=

# 可选：直接给一个现成的 token（一般不用，留空即可）
# 取值方式：浏览器登录 dekt.bupt.edu.cn 后，
# F12 → Application → Local Storage → secondclass.tokenv3
BUPT_TOKEN=

# ===== Telegram 推送 =====
# 1) 找 @BotFather 发 /newbot，得到形如 123456789:AAE... 的 token
# 2) 给新机器人发一条 /start
# 3) docker compose exec -T bupt-notification python -m bupt_notification detect-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 行为配置 =====
POLL_INTERVAL_MINUTES=30          # 检查频率（分钟）
TOKEN_REFRESH_MARGIN_HOURS=6      # token 剩余不足 N 小时就提前续期
PAGE_SIZE=50                      # 每次拉取的最新通知条数
INCLUDE_CONTENT=false             # true = 推送时附上正文全文
NOTIFY_ON_START=true              # 首次成功推送时发一条"监控已启用"
MAX_PENDING=100                   # 待发队列上限（超出丢最旧）
HTTP_TIMEOUT_SECONDS=25

# ===== 可选 =====
# CHROME_PATH=                    # 手动指定 Chromium；默认自动探测（容器里用镜像自带的）
# LOG_FILE=                       # 额外写日志文件；docker 下看 stdout 即可
# STATE_FILE=                     # 默认 ./data/state.json（compose 里注入 /app/data/state.json）
